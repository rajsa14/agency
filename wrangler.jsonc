{
  // Cloudflare Workers: static files from public/, the API from worker.js, data in D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agency"
    }
  ],
  "observability": { "enabled": true }
  // Secrets, set once in the dashboard or with `wrangler secret put`:
  //   ADMIN_PASSWORD      the password for the office (without it the site is view-only)
  //   ANTHROPIC_API_KEY   the key agents work with (without it no task runs)
}
